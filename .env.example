# DDN_DIMinfra environment configuration.
# Copy to `.env` (which is git-ignored) and tweak as needed.
# Load it in PowerShell with:
#   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+?)\s*=\s*(.+?)\s*$') { Set-Item -Path "Env:$($matches[1])" -Value $matches[2] } }

# ── Routing (self-hosted, see docker-compose.routing.yml) ─────────────
# Truck / road routing via local OSRM container.
OSRM_URL=http://127.0.0.1:5500
OSRM_TIMEOUT_S=10

# Inland-waterway routing via local BRouter container.
BROUTER_URL=http://127.0.0.1:17777
BROUTER_PROFILE=barge
BROUTER_TIMEOUT_S=12

# Overpass: only used as a third-tier waterway fallback. Leave on the
# public endpoint (rate-limited but free) or self-host it.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_S=20

# Master kill-switch: 1 = disable ALL outbound network calls
# (OSRM/Overpass/Nominatim) and use haversine + straight-line geometry.
# Leave unset / set to 0 when you want the local routing stack above
# to be used.
DDN_OFFLINE=0

# Geocode preference for ambiguous bare-name lookups (lower index = higher priority).
DDN_GEOCODE_COUNTRY_PREFERENCE=be,nl,lu,fr,de,it,es,pl,no,dk,se

# ── Flask app ─────────────────────────────────────────────────────────
# Persistent secret so signing-link sessions survive restarts.
DDN_SECRET_KEY=change-me-to-a-long-random-string
# Set to 1 only when serving over HTTPS (forces the Secure cookie flag).
DDN_COOKIE_SECURE=0
# Max upload size in MB.
DDN_MAX_UPLOAD_MB=32
